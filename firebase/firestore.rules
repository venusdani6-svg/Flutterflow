rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Admin app: clients may only read/write their own user profile.
    // All other admin operations go through Cloud Functions (Admin SDK).
    match /users/{userId} {
      allow create: if request.auth != null && request.auth.uid == userId;
      allow read: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Invitation tokens (typo preserved: invitions).
    match /invitions/{document} {
      allow create: if true;
      allow read: if true;
      allow write: if false;
      allow delete: if false;
    }

    // Deny direct client access to all other collections.
    // Admin Cloud Functions use the Admin SDK and bypass these rules.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
